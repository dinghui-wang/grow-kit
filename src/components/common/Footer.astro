---
const footerLinks = {
  products: [
    { href: '/cultivation', label: 'Cultivation Equipment' },
    { href: '/packaging', label: 'Packaging Solutions' },
  ],
  company: [
    { href: '/custom', label: 'Custom Solutions' },
    { href: '/blog', label: 'Blog' },
    { href: '/contact', label: 'Contact' },
  ],
  support: [
    { href: '/faq', label: 'FAQ' },
    { href: '/shipping', label: 'Shipping Info' },
    { href: '/privacy', label: 'Privacy Policy' },
  ],
};

const socialLinks = [
  { href: '#', label: 'Twitter', icon: 'twitter' },
  { href: '#', label: 'LinkedIn', icon: 'linkedin' },
  { href: '#', label: 'Instagram', icon: 'instagram' },
];
---

<footer class="bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800">
  <div class="container-custom py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand Column -->
      <div class="md:col-span-1">
        <a href="/" class="flex items-center space-x-2 mb-4">
          <svg class="w-8 h-8 text-primary-600 dark:text-primary-400" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
          </svg>
          <span class="text-xl font-bold text-gray-900 dark:text-white">Grow-Kit</span>
        </a>
        <p class="text-gray-600 dark:text-gray-400 text-sm">
          Professional cannabis cultivation equipment and packaging solutions for B2B clients.
        </p>
      </div>
      
      <!-- Products Column -->
      <div>
        <h3 class="text-sm font-semibold text-gray-900 dark:text-white uppercase tracking-wider mb-4">
          Products
        </h3>
        <ul class="space-y-2">
          {footerLinks.products.map(link => (
            <li>
              <a
                href={link.href}
                class="text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors text-sm"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Company Column -->
      <div>
        <h3 class="text-sm font-semibold text-gray-900 dark:text-white uppercase tracking-wider mb-4">
          Company
        </h3>
        <ul class="space-y-2">
          {footerLinks.company.map(link => (
            <li>
              <a
                href={link.href}
                class="text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors text-sm"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <!-- Support Column -->
      <div>
        <h3 class="text-sm font-semibold text-gray-900 dark:text-white uppercase tracking-wider mb-4">
          Support
        </h3>
        <ul class="space-y-2">
          {footerLinks.support.map(link => (
            <li>
              <a
                href={link.href}
                class="text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors text-sm"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    
    <!-- Bottom Bar -->
    <div class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-800">
      <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
        <p class="text-gray-600 dark:text-gray-400 text-sm">
          © {new Date().getFullYear()} Grow-Kit. All rights reserved.
        </p>
        
        <div class="flex items-center space-x-6">
          {socialLinks.map(link => (
            <div>
              {link.label}
            </div>
            <a
              href={link.href}
              class="text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
              aria-label={link.label}
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
