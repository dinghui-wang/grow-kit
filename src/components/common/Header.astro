---
import ThemeToggle from './ThemeToggle.astro';
import categoriesData from '@data/categories.json';

// Get active categories only
const activeCategories = Object.values(categoriesData.categories).filter(
  cat => cat.status === 'active'
);

const topLinks = [
  { href: '/contact', label: 'Contact' },
  { href: '/faq', label: 'FAQs' },
];

const socialLinks = [
  { href: 'https://instagram.com', label: 'Instagram', icon: 'instagram' },
  { href: 'https://linkedin.com', label: 'LinkedIn', icon: 'linkedin' },
  { href: 'https://twitter.com', label: 'Twitter', icon: 'twitter' },
];
---

<header class="sticky top-0 z-50 bg-white dark:bg-gray-950 border-b border-gray-200 dark:border-gray-800">
  <!-- Top Bar -->
  <div class="bg-gray-50 dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800">
    <div class="container-custom">
      <div class="flex items-center justify-between h-10">
        <!-- Left: Contact & FAQs -->
        <div class="flex items-center space-x-6">
          {topLinks.map(link => (
            <a
              href={link.href}
              class="text-xs text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
            >
              {link.label}
            </a>
          ))}
        </div>

        <!-- Right: Social & Theme Toggle -->
        <div class="flex items-center space-x-4">
          <!-- Social Links -->
          <div class="flex items-center space-x-3">
            {socialLinks.map(link => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                aria-label={link.label}
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  {link.icon === 'instagram' && (
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  )}
                  {link.icon === 'linkedin' && (
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                  )}
                  {link.icon === 'twitter' && (
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  )}
                </svg>
              </a>
            ))}
          </div>

          <!-- Theme Toggle -->
          <ThemeToggle />
        </div>
      </div>
    </div>
  </div>

  <!-- Main Navigation -->
  <div class="container-custom">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-2 group">
        <svg class="w-8 h-8 text-primary-600 dark:text-primary-400" viewBox="0 0 24 24" fill="currentColor">
          <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
        </svg>
        <span class="text-xl font-bold text-gradient">Grow-Kit</span>
      </a>

      <!-- Center Navigation -->
      <nav class="hidden lg:flex items-center space-x-8">
        <a href="/" class="text-gray-600 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors font-medium">
          Home
        </a>

        <!-- Dynamic Category Menus -->
        {activeCategories.map(category => (
          <div class="relative group">
            <button class="flex items-center space-x-1 text-gray-600 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors font-medium">
              <span>{category.name}</span>
              {Object.keys(category.subcategories).length > 0 && (
                <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              )}
            </button>

            {Object.keys(category.subcategories).length > 0 && (
              <div class="fixed top-[116px] left-0 right-0 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 pointer-events-none group-hover:pointer-events-auto z-50">
                <div class="flex justify-center">
                  <div class="bg-white dark:bg-gray-900 shadow-2xl border-t border-l border-r border-gray-200 dark:border-gray-700 overflow-hidden" style="width: 1280px; max-width: 100%;">
                    <div class="py-8 px-8">
                      <!-- Header -->
                      <div class="flex items-center justify-between mb-8 pb-6 border-b border-gray-200 dark:border-gray-700">
                        <div>
                          <h3 class="text-2xl font-bold text-gray-900 dark:text-white">{category.name}</h3>
                          <p class="text-base text-gray-500 dark:text-gray-400 mt-2">{category.description}</p>
                        </div>
                        <a href={`/products/${category.slug}`} class="flex items-center space-x-2 px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white rounded-lg text-base font-medium transition-colors shadow-lg hover:shadow-xl">
                          <span>View All Products</span>
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                          </svg>
                        </a>
                      </div>

                      <!-- Subcategories Grid -->
                      <div class="grid grid-cols-3 gap-6">
                        {Object.values(category.subcategories).map(sub => (
                          <a
                            href={`/products/${category.slug}/${sub.slug}`}
                            class="flex items-start space-x-4 p-5 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-800 transition-all group/item border border-transparent hover:border-gray-200 dark:hover:border-gray-700 hover:shadow-lg"
                          >
                            <!-- Icon -->
                            <div class="flex-shrink-0 w-14 h-14 bg-primary-100 dark:bg-primary-900/30 rounded-xl flex items-center justify-center group-hover/item:bg-primary-200 dark:group-hover/item:bg-primary-800/50 transition-colors shadow-sm">
                              <svg class="w-7 h-7 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                              </svg>
                            </div>
                            <!-- Content -->
                            <div class="flex-1 min-w-0">
                              <div class="text-base font-semibold text-gray-900 dark:text-white group-hover/item:text-primary-600 dark:group-hover/item:text-primary-400 transition-colors mb-1">
                                {sub.name}
                              </div>
                              <p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-2">
                                {sub.description}
                              </p>
                            </div>
                            <!-- Arrow -->
                            <svg class="w-5 h-5 text-gray-400 dark:text-gray-500 group-hover/item:text-primary-600 dark:group-hover/item:text-primary-400 group-hover/item:translate-x-1 transition-all mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                          </a>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>
        ))}

        <a href="/custom" class="text-gray-600 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors font-medium">
          Custom
        </a>

        <a href="/blog" class="text-gray-600 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors font-medium">
          Blog
        </a>
      </nav>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="lg:hidden p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-200 dark:border-gray-800">
    <div class="container-custom py-4 space-y-2">
      <a href="/" class="block px-4 py-2 text-gray-600 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg transition-colors font-medium">
        Home
      </a>

      {activeCategories.map(category => (
        <div class="px-4 py-2">
          <div class="font-medium text-gray-900 dark:text-white mb-2">{category.name}</div>
          {Object.keys(category.subcategories).length > 0 && (
            <div class="ml-4 space-y-1">
              <a href={`/products/${category.slug}`} class="block py-1 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-600">All Products</a>
              {Object.values(category.subcategories).map(sub => (
                <a href={`/products/${category.slug}/${sub.slug}`} class="block py-1 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-600">
                  {sub.name}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}

      <a href="/custom" class="block px-4 py-2 text-gray-600 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg transition-colors font-medium">
        Custom
      </a>

      <a href="/blog" class="block px-4 py-2 text-gray-600 dark:text-gray-300 hover:text-primary-600 dark:hover:text-primary-400 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg transition-colors font-medium">
        Blog
      </a>
    </div>
  </div>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuButton && mobileMenu) {
    mobileMenuButton.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
