---
import Layout from '@layouts/Layout.astro';
---

<Layout 
  title="Custom Solutions"
  description="Get custom cannabis cultivation equipment and packaging solutions tailored to your specific needs"
>
  <div class="container-custom py-12">
    <!-- Page Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        Custom Solutions
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
        Can't find what you're looking for? We offer custom manufacturing and branding services to meet your specific requirements.
      </p>
    </div>

    <!-- Custom Services Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
      <!-- Custom Manufacturing -->
      <div class="card-hover p-8">
        <div class="w-16 h-16 bg-primary-100 dark:bg-primary-900 rounded-full flex items-center justify-center mb-6">
          <svg class="w-8 h-8 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">
          Custom Manufacturing
        </h3>
        <p class="text-gray-600 dark:text-gray-300 mb-4">
          We can manufacture cultivation equipment and packaging solutions according to your exact specifications and requirements.
        </p>
        <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
          <li class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Custom dimensions & specifications
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Material selection
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            OEM/ODM services
          </li>
        </ul>
      </div>

      <!-- Custom Branding -->
      <div class="card-hover p-8">
        <div class="w-16 h-16 bg-primary-100 dark:bg-primary-900 rounded-full flex items-center justify-center mb-6">
          <svg class="w-8 h-8 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">
          Custom Branding
        </h3>
        <p class="text-gray-600 dark:text-gray-300 mb-4">
          Add your brand identity to our products with custom logos, colors, and packaging designs.
        </p>
        <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
          <li class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Custom logo printing
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Brand color matching
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Private label options
          </li>
        </ul>
      </div>

      <!-- Bulk Orders -->
      <div class="card-hover p-8">
        <div class="w-16 h-16 bg-primary-100 dark:bg-primary-900 rounded-full flex items-center justify-center mb-6">
          <svg class="w-8 h-8 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">
          Bulk Orders
        </h3>
        <p class="text-gray-600 dark:text-gray-300 mb-4">
          Special pricing and priority production for large volume wholesale orders.
        </p>
        <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
          <li class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Volume discounts
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Priority production
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Dedicated support
          </li>
        </ul>
      </div>
    </div>

    <!-- Process Section -->
    <div class="bg-primary-50 dark:bg-gray-800 rounded-2xl p-8 md:p-12 mb-12">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-8 text-center">
        How It Works
      </h2>
      <div class="grid md:grid-cols-4 gap-6">
        <div class="text-center">
          <div class="w-12 h-12 bg-primary-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-lg">
            1
          </div>
          <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Contact Us</h3>
          <p class="text-sm text-gray-600 dark:text-gray-300">Tell us about your custom requirements</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-primary-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-lg">
            2
          </div>
          <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Consultation</h3>
          <p class="text-sm text-gray-600 dark:text-gray-300">We discuss options and provide quotes</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-primary-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-lg">
            3
          </div>
          <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Production</h3>
          <p class="text-sm text-gray-600 dark:text-gray-300">We manufacture your custom solution</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-primary-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold text-lg">
            4
          </div>
          <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Delivery</h3>
          <p class="text-sm text-gray-600 dark:text-gray-300">Receive your custom products</p>
        </div>
      </div>
    </div>

    <!-- CTA Section -->
    <div class="text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-4">
        Ready to Start Your Custom Project?
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-300 mb-6">
        Contact our team to discuss your specific requirements and get a custom quote.
      </p>
      <a href="/contact" class="btn-primary">
        Contact Us for Custom Orders
      </a>
    </div>
  </div>
</Layout>
