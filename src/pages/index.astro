---
import Layout from "@layouts/Layout.astro";
import ProductCard from "@components/product/ProductCard.astro";
import HomeHero from "@assets/homehero.jpg";
import Led from "@assets/led.jpg";
import Factory from "@assets/factory.jpg";
import categoriesData from "@data/categories.json";
import ledProducts from "@data/products/grow-lights/led.json";

const growLightsCategory = categoriesData.categories["grow-lights"];

// Featured products (LED grow lights)
const featuredProducts = ledProducts
  .filter((p) => p.isFeatured)
  .slice(0, 4)
  .map((p) => ({
    ...p,
    image: Led.src, // Use placeholder for now
  }));
---

<Layout
  title="Professional Grow Lights for Indoor Cultivation | Grow-Kit"
  description="Grow-Kit offers premium LED, HPS, and CMH grow lights for commercial cannabis cultivation. Factory direct wholesale pricing with worldwide shipping."
>
  <!-- Hero Section -->
  <section
    class="relative min-h-[600px] md:min-h-[700px] overflow-hidden pb-16"
  >
    <!-- Background Image -->
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat"
      style={`background-image: url(${HomeHero.src})`}
    >
    </div>
    <!-- Dark Overlay for better text readability -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/40"
    >
    </div>

    <!-- Content -->
    <div class="relative container-custom py-20 md:py-32">
      <div class="max-w-2xl">
        <div class="animate-fade-in">
          <h1
            class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 drop-shadow-lg"
          >
            Professional <span class="text-primary-400">Grow Lights</span>
            for Indoor Cultivation
          </h1>
          <p class="text-lg md:text-xl text-gray-200 mb-8 drop-shadow-md">
            Premium LED, HPS, and CMH grow lights for commercial cannabis
            cultivation. Factory direct wholesale pricing with OEM
            customization.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/products/grow-lights" class="btn-primary">
              Browse Grow Lights
              <svg
                class="w-5 h-5 ml-2"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"
                >
                </path>
              </svg>
            </a>
            <a
              href="/contact"
              class="px-6 py-3 bg-white/10 backdrop-blur-sm border border-white/30 text-white font-semibold rounded-lg hover:bg-white/20 transition-colors inline-flex items-center justify-center"
            >
              Request Quote
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Advantages Section -->
  <section class="relative -mt-16 z-10 mb-16">
    <div class="container-custom">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        <!-- Commercial Grade -->
