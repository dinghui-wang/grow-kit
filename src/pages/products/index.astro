---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/product/ProductCard.astro';
import categoriesData from '../../data/categories.json';

const categories = Object.entries(categoriesData.categories);
---

<Layout 
  title="Products"
  description="Browse our complete range of cannabis cultivation equipment and packaging solutions"
>
  <div class="container-custom py-12">
    <!-- Page Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
        Our Products
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
        Premium cannabis cultivation equipment and packaging solutions for B2B clients
      </p>
    </div>

    <!-- Categories Grid -->
    <div class="grid md:grid-cols-2 gap-8 mb-12">
      {categories.map(([key, category]) => {
        const href = key === 'cultivation' ? '/products/cultivation' : '/products/packaging';
        return (
          <a
            href={href}
            class="card-hover group p-8 flex flex-col items-center text-center"
          >
            <div class="w-24 h-24 bg-primary-100 dark:bg-primary-900 rounded-full flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-12 h-12 text-primary-600 dark:text-primary-400" fill="currentColor" viewBox="0 0 24 24">
                {key === 'cultivation' ? (
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                ) : (
                  <path d="M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4l16-.02V7z"/>
                )}
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
              {category.name}
            </h2>
            <p class="text-gray-600 dark:text-gray-300 mb-4">
              {category.description}
            </p>
            <div class="text-sm text-primary-600 dark:text-primary-400 font-medium">
              {Object.keys(category.subcategories).length} categories →
            </div>
          </a>
        );
      })}
    </div>

    <!-- CTA Section -->
    <div class="bg-primary-50 dark:bg-gray-800 rounded-2xl p-8 text-center">
      <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">
        Need Custom Solutions?
      </h3>
      <p class="text-gray-600 dark:text-gray-300 mb-4">
        We offer custom packaging and equipment solutions for your specific needs
      </p>
      <a href="/contact" class="btn-primary">
        Contact Us for Custom Orders
      </a>
    </div>
  </div>
</Layout>
