---
import Layout from "@layouts/Layout.astro";
import ProductCard from "@components/product/ProductCard.astro";
import categoriesData from "@data/categories.json";

export async function getStaticPaths() {
  const growLightsCategory = categoriesData.categories['grow-lights'];
  const paths = Object.keys(growLightsCategory.subcategories).map(slug => ({
    params: { slug },
  }));
  return paths;
}

const growLightsCategory = categoriesData.categories['grow-lights'];

const { slug } = Astro.params;
const subcategory = growLightsCategory.subcategories[slug as keyof typeof growLightsCategory.subcategories];

if (!subcategory) {
  return Astro.redirect('/products/grow-lights');
}

// Load products for this subcategory
let products: any[] = [];
try {
  const productData = await import(`../../data/products/grow-lights/${slug}.json`);
  products = productData.default || [];
} catch {
  products = [];
}
---

<Layout
  title={`${subcategory.name} | Grow-Kit`}
  description={subcategory.description}
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-gray-50 to-primary-50 dark:from-gray-900 dark:to-gray-950 py-16">
    <div class="container-custom">
      <div class="max-w-3xl">
        <nav class="text-sm text-gray-600 dark:text-gray-400 mb-4">
          <a href="/" class="hover:text-primary-600">Home</a>
          <span class="mx-2">/</span>
          <a href="/products/grow-lights" class="hover:text-primary-600">Grow Lights</a>
          <span class="mx-2">/</span>
          <span class="text-gray-900 dark:text-white">{subcategory.name}</span>
        </nav>
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
          {subcategory.name}
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-300">
          {subcategory.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Subcategories Navigation -->
  <section class="bg-white dark:bg-gray-950 border-b border-gray-200 dark:border-gray-800 py-4 sticky top-16 z-40">
    <div class="container-custom">
      <div class="flex items-center space-x-4 overflow-x-auto pb-2">
        <a
          href="/products/grow-lights"
          class="px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-lg font-medium whitespace-nowrap transition-colors"
        >
          All Grow Lights
        </a>
        {Object.values(growLightsCategory.subcategories).map(sub => (
          <a
            href={`/products/${growLightsCategory.slug}/${sub.slug}`}
            class={`px-4 py-2 rounded-lg font-medium whitespace-nowrap transition-colors ${
              sub.slug === slug
                ? 'bg-primary-600 text-white'
                : 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700'
            }`}
          >
            {sub.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Products Grid -->
  <section class="py-16">
    <div class="container-custom">
      {products.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {products.map((product) => (
            <ProductCard product={{...product, image: '/images/placeholder-product.jpg'}} />
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <p class="text-gray-600 dark:text-gray-400 text-lg mb-2">No products in this category yet.</p>
          <p class="text-gray-500 dark:text-gray-500 text-sm">Check back soon or contact us for availability.</p>
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-gray-50 dark:bg-gray-900">
    <div class="container-custom">
      <div class="text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-4">
          Can't Find What You Need?
        </h2>
        <p class="text-gray-600 dark:text-gray-300 mb-8">
          We offer custom solutions and can source specific products for your business.
        </p>
        <a href="/contact" class="btn-primary inline-flex items-center">
          Contact Us
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
