---
import Layout from "@layouts/Layout.astro";
import ProductCard from "@components/product/ProductCard.astro";
import categoriesData from "@data/categories.json";
import ledProducts from "@data/products/grow-lights/led.json";

const growLightsCategory = categoriesData.categories["grow-lights"];

// Combine all products from different subcategories
const allProducts = [...ledProducts];
---

<Layout
  title="Grow Lights for Indoor Cultivation | Grow-Kit"
  description="Professional LED, HPS, CMH and fluorescent grow lights for commercial cannabis cultivation. Factory direct wholesale pricing with worldwide shipping."
>
  <!-- Hero -->
  <section
    class="bg-gradient-to-br from-gray-50 to-primary-50 dark:from-gray-900 dark:to-gray-950 py-16"
  >
    <div class="container-custom">
      <div class="max-w-3xl">
        <h1
          class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4"
        >
          {growLightsCategory.name}
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-300">
          {growLightsCategory.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Subcategories Navigation -->
  <section
    class="bg-white dark:bg-gray-950 border-b border-gray-200 dark:border-gray-800 py-4 sticky top-16 z-40"
  >
    <div class="container-custom">
      <div class="flex items-center space-x-4 overflow-x-auto pb-2">
        <a
          href="/products/grow-lights"
          class="px-4 py-2 bg-primary-600 text-white rounded-lg font-medium whitespace-nowrap"
        >
          All Grow Lights
        </a>
        {
          Object.values(growLightsCategory.subcategories).map((sub) => (
            <a
              href={`/products/${growLightsCategory.slug}/${sub.slug}`}
              class="px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 rounded-lg font-medium whitespace-nowrap transition-colors"
            >
              {sub.name}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Products Grid -->
  <section class="py-16">
    <div class="container-custom">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {
          allProducts.map((product) => (
            <ProductCard
              product={{ ...product, image: "/images/placeholder-product.jpg" }}
            />
          ))
        }
      </div>

      {
        allProducts.length === 0 && (
          <div class="text-center py-16">
            <svg
              class="w-16 h-16 text-gray-400 mx-auto mb-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            <p class="text-gray-600 dark:text-gray-400">No products found.</p>
          </div>
        )
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-gray-50 dark:bg-gray-900">
    <div class="container-custom">
      <div class="text-center">
        <h2
          class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-4"
        >
          Need Custom Solutions?
        </h2>
        <p class="text-gray-600 dark:text-gray-300 mb-8">
          We offer OEM/ODM services and can customize products to your
          specifications.
        </p>
        <a href="/contact" class="btn-primary inline-flex items-center">
          Request Quote
          <svg
            class="w-5 h-5 ml-2"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
